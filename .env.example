# Copy to .env and fill in. Nothing secret is hardcoded in the source tree.

# SQLAlchemy URL (psycopg v3 driver)
DATABASE_URL=postgresql+psycopg://chai_user:CHANGE_ME@localhost:5432/chai_hut

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"   (min 32 chars)
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Business rules
BUSINESS_TIMEZONE=Asia/Kolkata
DEFAULT_GST_RATE=5.00
MANAGER_SALES_WINDOW_DAYS=7

# Comma separated list, leave empty to disable CORS
CORS_ORIGINS=

# Used only by `python -m app.utils.bootstrap_owner` (first owner account)
OWNER_USERNAME=
OWNER_PASSWORD=
OWNER_FULL_NAME=Chai Hut Owner

# docker-compose only
POSTGRES_USER=chai_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=chai_hut
