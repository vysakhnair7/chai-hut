# Base URL of the Chai Hut FastAPI backend (no trailing slash).
# The backend must list this app's origin in its CORS_ORIGINS (e.g. http://localhost:5173).
VITE_API_BASE_URL=http://localhost:8000

# Timezone used for "today", "yesterday" etc. in date filters. Must match the backend's BUSINESS_TIMEZONE.
VITE_BUSINESS_TIMEZONE=Asia/Kolkata

# Request timeout in milliseconds.
VITE_API_TIMEOUT_MS=15000
